# Variáveis do container Java; não reutilize o arquivo público com valores reais.
S3_BUCKET=
AWS_DEFAULT_REGION=us-east-1
DB_HOST=banco
DB_PORT=3306
DB_DATABASE=streamguard
DB_USER=streamguard_alertas
DB_PASSWORD=
DB_SSL_MODE=PREFERRED
CAPTURA_FUSO=America/Sao_Paulo
ESTADO_DIRETORIO=/estado
ALERTAS_INTERVALO_SEGUNDOS=15
CONFIG_INTERVALO_SEGUNDOS=60
RECUPERACAO_AMOSTRAS=2
SILVER_MAX_BYTES=67108864
SILVER_MAX_IDADE_SEGUNDOS=900
HTTP_TIMEOUT_SEGUNDOS=30
JIRA_ENVIAR=false
JIRA_DOMAIN=stream-guard
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=SUP
JIRA_ISSUE_TYPE=Incident
SLACK_ENVIAR=false
SLACK_WEBHOOK_URL=
